<span class="text-dim-red font-bold">▏error[E0116]</span><span class="text-mid-grey">: cannot define inherent `impl` for a</span>
<span class="text-dim-red font-bold">▏</span><span class="text-mid-grey"> type outside the crate where the type is defined</span>
<span class="text-dim-red font-bold">▏</span>
<span class="text-dim-red underline-dim-red"><span class="-mr-[0.5rem]">▏</span><span class="text-dim-magenta">impl</span><span class="text-dim-white">&lt;</span><span class="text-dim-blue">T</span><span class="text-dim-white">&gt;</span> <span class="text-dim-blue">Option</span><span class="text-dim-white">&lt;</span><span class="text-dim-blue">T</span><span class="text-dim-white">&gt;</span></span> <span class="text-dim-white">{ </span>
    <span class="text-dim-magenta">fn</span> <span class="text-dim-red">ok</span><span class="text-dim-white">(</span><span class="text-blue">self</span><span class="text-dim-white">)</span> -&gt; <span class="text-dim-blue">Result</span><span class="text-dim-white">&lt;</span><span class="text-dim-blue">T</span><span class="text-grey">,</span> <span class="text-dim-blue">NoneError</span><span class="text-dim-white">&gt;</span> <span class="text-dim-white">{</span>
        <span class="text-blue">self</span><span class="text-grey">.</span><span class="text-dim-red">ok_or_else</span><span class="text-dim-white">(</span><span class="text-dim-blue">NoneError</span><span class="text-grey">::</span>default<span class="text-dim-white">)</span>
    <span class="text-dim-white">}</span>
<span class="text-dim-white">}</span>