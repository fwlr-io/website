<span class="text-dim-magenta">fn</span> <span class="text-dim-red">strip_prefix</span><span class="text-dim-white">(</span><span class="text-blue">string</span><span class="text-grey">:</span> <span class="text-dim-white">&amp;</span><span class="text-dim-blue">str</span><span class="text-grey">,</span> <span class="text-blue">prefix</span><span class="text-grey">:</span> <span class="text-dim-white">&amp;</span><span class="text-dim-blue">str</span><span class="text-dim-white">)</span> -&gt; io<span class="text-grey">::</span><span class="text-dim-blue">Result</span><span class="text-dim-white">&lt;</span><span class="text-dim-blue">String</span><span class="text-dim-white">&gt;</span> <span class="text-dim-white">{</span>
    <span class="text-dim-magenta">match</span> string<span class="text-grey">.</span><span class="text-dim-red">strip_prefix</span><span class="text-dim-white">(</span>prefix<span class="text-dim-white">)</span> <span class="text-dim-white">{</span>
        <span class="text-dim-magenta">Some</span><span class="text-dim-white">(</span>s<span class="text-dim-white">)</span> =&gt; <span class="text-dim-red">Ok</span><span class="text-dim-white">(</span>s<span class="text-grey">.</span><span class="text-dim-red">to_string</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span><span class="text-dim-white">)</span><span class="text-grey">,</span>
        <span class="text-dim-magenta">None</span> =&gt; <span class="text-dim-red">Err</span><span class="text-dim-white">(</span>io<span class="text-grey">::</span><span class="text-dim-blue">Error</span><span class="text-grey">::</span><span class="text-dim-red">other</span><span class="text-dim-white">(</span><span class="text-green">&quot;no prefix&quot;</span><span class="text-dim-white">)</span><span class="text-dim-white">)</span><span class="text-grey">,</span>
    <span class="text-dim-white">}</span>
<span class="text-dim-white">}</span>
