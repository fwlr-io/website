<span class="text-dim-magenta">const</span> option<span class="text-grey">:</span> <span class="text-dim-blue">Option</span><span class="text-dim-white">&lt;</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span><span class="text-dim-white">&gt;</span> = <span class="text-dim-magenta">None</span><span class="text-grey">;</span>
<span class="text-dim-magenta">const</span> result<span class="text-grey">:</span> <span class="text-dim-blue">Result</span><span class="text-dim-white">&lt;</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span><span class="text-grey">,</span> <span class="text-dim-blue">Error</span><span class="text-dim-white">&gt;</span> = <span class="text-dim-red">Ok</span><span class="text-dim-white">(</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span><span class="text-dim-white">)</span><span class="text-grey">;</span>

<span class="text-dim-magenta">fn</span> <span class="text-dim-red">f</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span> -&gt; <span class="text-dim-blue">Option</span><span class="text-dim-white">&lt;</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span><span class="text-dim-white">&gt;</span> <span class="text-dim-white">{</span>
    option?<span class="text-grey">;</span>
<span class="text-dim-white">}</span>

<span class="text-dim-magenta">fn</span> <span class="text-dim-red">g</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span> -&gt; <span class="text-dim-blue">Result</span><span class="text-dim-white">&lt;</span><span class="text-dim-white">(</span><span class="text-dim-white">)</span><span class="text-grey">,</span> <span class="text-dim-blue">Error</span><span class="text-dim-white">&gt;</span> <span class="text-dim-white">{</span>
    result?<span class="text-grey">;</span>
<span class="text-dim-white">}</span>
