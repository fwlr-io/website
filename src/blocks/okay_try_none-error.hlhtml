<span class="text-dim-white">}</span>
<span class="text-dim-magenta">impl</span> fmt<span class="text-grey">::</span><span class="text-dim-blue">Display</span> <span class="text-dim-magenta">for</span> <span class="text-dim-blue">NoneError</span> <span class="text-dim-white">{</span>
    <span class="text-dim-magenta">fn</span> <span class="text-dim-red">fmt</span><span class="text-dim-white">(</span><span class="text-dim-white">&amp;</span><span class="text-blue">self</span><span class="text-grey">,</span> <span class="text-blue">f</span><span class="text-grey">:</span> <span class="text-dim-white">&amp;</span><span class="text-dim-magenta">mut</span> fmt<span class="text-grey">::</span><span class="text-dim-blue">Formatter</span><span class="text-dim-white">&lt;</span><span class="text-dim-white">&#39;</span><span class="text-dim-white">_</span><span class="text-dim-white">&gt;</span><span class="text-dim-white">)</span> -&gt; fmt<span class="text-grey">::</span><span class="text-dim-blue">Result</span> <span class="text-dim-white">{</span>
        <span class="text-dim-green">write</span><span class="text-dim-green">!</span><span class="text-dim-white">(</span>f<span class="text-grey">,</span> <span class="text-green">&quot;Called `ok()?` on a `None` at {}&quot;</span><span class="text-grey">,</span> <span class="text-blue">self</span><span class="text-grey">.</span><span class="text-cyan">0</span><span class="text-dim-white">)</span>
