<span class="text-dim-magenta">fn</span> <span class="text-dim-red">read_file</span><span class="text-dim-white">(</span><span class="text-blue">file</span><span class="text-grey">:</span> <span class="text-dim-white">&amp;</span><span class="text-dim-blue">Path</span><span class="text-dim-white">)</span> -&gt; <span class="text-dim-blue">Option</span><span class="text-dim-white">&lt;</span><span class="text-dim-blue">String</span><span class="text-dim-white">&gt;</span> <span class="text-dim-white">{</span>
    <span class="text-dim-magenta">match</span> fs<span class="text-grey">::</span><span class="text-dim-red">read_to_string</span><span class="text-dim-white">(</span>file<span class="text-dim-white">)</span> <span class="text-dim-white">{</span>
        <span class="text-dim-magenta">Ok</span><span class="text-dim-white">(</span>x<span class="text-dim-white">)</span> =&gt; <span class="text-dim-red">Some</span><span class="text-dim-white">(</span>x<span class="text-dim-white">)</span><span class="text-grey">,</span>
        <span class="text-dim-magenta">Err</span><span class="text-dim-white">(</span>e<span class="text-dim-white">)</span> =&gt; <span class="text-dim-white">{</span>
            <span class="text-dim-green">eprintln</span><span class="text-dim-green">!</span><span class="text-dim-white">(</span><span class="text-green">&quot;{e}&quot;</span><span class="text-dim-white">)</span><span class="text-grey">;</span>
            <span class="text-dim-magenta">None</span>
        <span class="text-dim-white">}</span>
    <span class="text-dim-white">}</span>
<span class="text-dim-white">}</span>
